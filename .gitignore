# Datasets (6.2GB+ — download separately)
dataset/
dataset_backup/

# Results (JLD2 value functions, scores — regenerated by scripts)
results_sdp/

# EMSx.jl is a git submodule/clone — has its own .git
EMSx.jl/

# Paper PDF and figures (not source code)
paper/*.pdf
paper/*.png
paper/*.xlsx

# Julia compiled/manifest
*.jl.cov
*.jl.mem
/.julia-depot/
/.worktrees/
# Package-local manifests stay ignored; the application lockfile is tracked.
**/Manifest.toml
!/Manifest.toml

# Local tool-routing helpers
/api.json
/toapi.py

# Personal infra / experiments — never publish (may hold LAN credentials)
/mac.sh
/sshmac.sh
/export_kimi_ccswitch_registry.py
/leanproof_mine/

# Python bytecode in visualization precompute
__pycache__/

# OS files
.DS_Store
*.swp
*~

# External dataset raw/intermediate data (large, not versioned)
external_data/ausgrid/validation/
external_data/ausgrid/processed/
external_data/ausgrid/*.csv
external_data/ausgrid/*.zip
external_data/aemo/raw/
external_data/aemo/validation/

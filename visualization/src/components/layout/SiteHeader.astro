---
/**
 * Site header: brand, navigation (9 pages), language switch.
 */
import LangSwitch from '../ui/LangSwitch.svelte';
import { t } from '../../lib/i18n';

const pages = [
  { href: '/', key: 'index' },
  { href: '/01_data_forecast/', key: 'forecast' },
  { href: '/02_dispatch/', key: 'dispatch' },
  { href: '/03_exploit/', key: 'exploit' },
  { href: '/04_timing/', key: 'timing' },
  { href: '/05_results/', key: 'results' },
  { href: '/06_per_site/', key: 'perSite' },
  { href: '/07_process/', key: 'process' },
  { href: '/08_sensitivity/', key: 'sensitivity' },
] as const;
const current = Astro.url.pathname;
---

<header class="site-header">
  <span class="brand">EMSx</span>
  <nav class="site-nav">
    {pages.map((p) => (
      <a href={p.href} data-i18n-key={p.key} aria-current={current === p.href || (p.href !== '/' && current.startsWith(p.href)) ? 'page' : undefined}>
        {t(`nav.${p.key}`)}
      </a>
    ))}
  </nav>
  <LangSwitch client:load />
</header>

<style is:global>
  /* styles live in global.css */
</style>
